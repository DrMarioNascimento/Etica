bonde":{"U":1,"V":-2,"I":-1,"E":-1,"C":-1},"rel":{"U":1,"D":-2,"V":-2,"Cu":-1,"J":-2},"resposta":{"quem":"Bruno","texto":"Bruno olha para o banco e depois para você. \"Está bem.\" Volta, e Kátia recomeça a responder pela mãe."}},{"id":"l_poupa","texto":"Tirar Zuleide da amostra, para não atrasar a coleta nem constrangê-la.","marca":["sem_ouvir","tirou_da_amostra"],"vai":"D6","por_que":"Você resolveu o prazo e a emoção tirando de cena quem se emocionou, sem perguntar a ela.","bonde":{"U":0,"V":-1,"I":0,"E":-2,"C":-1},"rel":{"U":1,"D":-1,"V":-1,"Cu":0,"J":-2},"resposta":{"quem":"Kátia","texto":"Kátia agradece a Bruno: \"Melhor. Ela se emociona à toa.\" Zuleide guarda o lenço na bolsa."}}]},"l_katia":{"tipo":"decisao","texto":"Meio-dia. Kátia vem à tenda: \"Tiraram minha mãe de perto de mim. E se ela cair no banco?\" Zuleide escolheu falar hoje, devagar, e está com Bruno. O que você faz?","opcoes":[{"id":"l_explica","texto":"Explicar a Kátia que ela também será ouvida, em campo próprio, e convidá-la a esperar à vista do banco.","marca":["a_sos","ouviu_katia"],"vai":"D4","por_que":"Você manteve a escolha de Zuleide e deu à preocupação de Kátia um lugar e um campo.","bonde":{"U":1,"V":2,"I":1,"E":1,"C":2},"rel":{"U":1,"D":2,"V":2,"Cu":2,"J":1},"resposta":{"quem":"Kátia","texto":"Kátia olha para o banco por um tempo. \"Eu fico aqui, de onde vejo. Depois quero falar da queda.\""}},{"id":"l_devolve","texto":"Pedir a Bruno que chame Kátia de volta para o lado da mãe e anote cada voz em seu campo.","marca":["juntas","campos_separados"],"vai":"D3","por_que":"Você atendeu o medo de Kátia e desfez a escolha que Zuleide tinha feito.","bonde":{"U":0,"V":0,"I":1,"E":-1,"C":1},"rel":{"U":0,"D":0,"V":0,"Cu":1,"J":0},"resposta":{"quem":"Bruno","texto":"Bruno chama Kátia. Zuleide abre espaço para a filha no banco e passa a responder mais curto."}}]}}},{"id":"zuleide","nome":"Zuleide","papel":"participante do grupo de caminhada, 78 anos","recebe":true,"apresentacao":"Você é Zuleide, tem 78 anos e caminha no grupo da praça há seis meses. Começou por ordem médica, depois de uma queda, e hoje puxa o alongamento das terças. Na entrevista, sua filha Kátia responde antes de você terminar de pensar.","fala":"\"Eu sei por que venho. Só demoro para dizer.\"","impulso":{"pergunta":"Com a filha respondendo por você e o rapaz esperando, o que você deseja?","opcoes":[{"id":"falar","texto":"Dizer com as minhas palavras por que venho.","eco":"Você queria dizer com suas palavras por que vem. Olhe se suas palavras chegaram ao papel, e como."},{"id":"paz","texto":"Não contrariar Kátia na frente dos outros.","eco":"Você queria não contrariar Kátia diante dos outros. Olhe o que isso guardou e o que deixou de fora."},{"id":"embora","texto":"Ir para casa e acabar logo com isso.","eco":"Você queria ir para casa e acabar logo. Olhe o que ficou por acabar."}]},"consultas_max":3,"inicio":"z_decide","nos":{"z_decide":{"tipo":"decisao","texto":"Sábado, 10h40. Kátia acaba de responder por você: \"Ela só vem porque o médico mandou.\" Bruno espera, com a caneta parada. O que você faz?","opcoes":[{"id":"z_pede_sos","texto":"Pedir a Bruno para terminar no banco da roda, só vocês dois, e dizer a Kátia que é rapidinho.","marca":["voz_propria","a_sos"],"vai":"z_banco","por_que":"Você mesma escolheu onde e com quem falar.","bonde":{"U":1,"V":2,"I":1,"E":2,"C":1},"rel":{"U":0,"D":1,"V":2,"Cu":1,"J":1},"resposta":{"quem":"Kátia","texto":"Kátia fica parada um instante. \"Se a senhora quer...\" Vai até a barraca de água e não tira os olhos do banco."}},{"id":"z_corrige","texto":"Dizer ali mesmo, com a filha ao lado: \"Comecei pelo médico. Mas hoje venho porque gosto.\"","marca":["voz_propria","falou_junto"],"vai":"D3","por_que":"Você corrigiu a filha sem tirá-la de perto.","bonde":{"U":1,"V":2,"I":1,"E":2,"C":2},"rel":{"U":1,"D":1,"V":2,"Cu":2,"J":1},"resposta":{"quem":"Kátia","texto":"Kátia olha para a mãe, surpresa. \"Gosta? A senhora nunca me disse.\" Bruno anota cada frase no campo de quem a disse."}},{"id":"z_outro","texto":"Pedir para responder outro dia, sem pressa e sem Kátia.","requer":["f_termo"],"marca":["voz_propria","outro_dia"],"vai":{"com_anexo":"D1","sem_anexo":"D2"},"por_que":"Você usou um direito escrito no termo para falar no seu tempo.","bonde":{"U":0,"V":1,"I":1,"E":2,"C":1},"rel":{"U":0,"D":1,"V":1,"Cu":1,"J":0},"resposta":{"quem":"Bruno","texto":"Bruno anota no caderno: \"Sábado que vem, 9h, banco da roda.\" E repete o que o termo diz: \"A senhora não perde nada no grupo por isso.\""}},{"id":"z_deixa","texto":"Deixar Kátia responder, para não contrariá-la na frente dos outros.","marca":["omissao","deixou_responder"],"vai":"D5","por_que":"Você poupou a filha de um desacordo em público, e ela continuou falando por você.","bonde":{"U":0,"V":0,"I":0,"E":0,"C":0},"rel":{"U":0,"D":0,"V":0,"Cu":0,"J":0}}]},"z_banco":{"tipo":"decisao","texto":"No banco da roda, Bruno relê a pergunta: \"Por que a senhora caminha?\" Ele lembra que você pode responder agora, devagar, ou marcar outro dia. O que você faz?","opcoes":[{"id":"z_hoje","texto":"Responder agora, no seu tempo.","marca":["respondeu_hoje"],"vai":"D4","por_que":"Você falou com suas palavras, no tempo de que precisou.","bonde":{"U":1,"V":2,"I":1,"E":2,"C":1},"rel":{"U":1,"D":1,"V":2,"Cu":1,"J":1},"resposta":{"quem":"Bruno","texto":"Bruno espera sem apressar. Quando você termina, ele lê em voz alta o que anotou e pergunta se está certo."}},{"id":"z_banco_outro","texto":"Pedir para continuar no sábado que vem, com mais calma.","marca":["outro_dia"],"vai":{"com_anexo":"D1","sem_anexo":"D2"},"por_que":"Você escolheu falar só quando estivesse pronta.","bonde":{"U":0,"V":1,"I":1,"E":2,"C":1},"rel":{"U":0,"D":1,"V":1,"Cu":1,"J":0},"resposta":{"quem":"Bruno","texto":"Bruno anota no caderno: \"Sábado que vem, 9h, aqui mesmo.\" E diz: \"A senhora não perde nada no grupo por isso.\""}}]}}}],"desfechos":{"D1":{"carimbo":"OUTRO DIA, COM ANEXO","titulo":"Zuleide responde no sábado seguinte","texto":"Na segunda, Luís envia o relatório com as entrevistas feitas e uma justificativa: Zuleide e os outros idosos que pediram mais tempo serão ouvidos a sós no sábado seguinte. A Secretaria aceita o anexo, e Rita passa duas semanas sem saber se continua. No outro sábado, no banco da roda, Zuleide responde devagar: \"Comecei pelo médico. Fiquei porque aqui eu sou eu.\" Kátia espera na barraca de água e, na volta, pergunta à mãe por que não podia ficar perto. Quinze dias depois, a renovação sai.","em_aberto":"Ouvir Zuleide a sós protegeu a voz dela ou afastou quem cuida dela?"},"D2":{"carimbo":"RENOVAÇÃO EM SUSPENSO","titulo":"A voz chega, a professora sai","texto":"Na segunda, Luís envia o relatório com as entrevistas feitas e uma justificativa: Zuleide e os outros que pediram mais tempo serão ouvidos a sós no sábado seguinte. A Secretaria responde que o ofício não prevê anexos e adia a renovação para o mês seguinte. Rita é remanejada para outra praça, e o grupo caminha três semanas sem professora. No outro sábado, Zuleide responde a sós, devagar: \"Aqui eu sou eu.\" Kátia passa a ir junto às terças, segurando o braço da mãe nas descidas.","em_aberto":"Uma resposta fiel vale o risco de o grupo perder a professora, e quem deveria carregar esse risco?"},"D3":{"carimbo":"JUNTAS, CAMPOS SEPARADOS","titulo":"Mãe e filha no mesmo banco","texto":"No fim da manhã, Zuleide responde com Kátia sentada ao lado, e Bruno anota cada voz em seu campo. Duas vezes Kátia completa a frase da mãe, e Bruno devolve a pergunta a Zuleide. No campo dela ficam a ordem do médico e uma frase curta sobre gostar do grupo; no de Kátia, a queda e os remédios. Sobre a casa, Zuleide não diz nada. Na segunda, o relatório chega completo, com a fala dos familiares marcada como \"informante\", e a renovação sai. Na saída, Kátia segura a mão da mãe e diz que não sabia que ela gostava tanto dali.","em_aberto":"Com a filha ao lado, a resposta de Zuleide era dela por inteiro?"},"D4":{"carimbo":"ZULEIDE ESCOLHE HOJE","titulo":"Zuleide responde a sós, no seu tempo","texto":"No fim da manhã, no banco da roda, Zuleide responde sem a filha, devagar, e leva quarenta minutos. Diz que começou pelo médico e ficou porque \"aqui eu sou eu\". Kátia espera à vista, na barraca de água, e depois é ouvida em campo próprio: fala da queda e do medo de outra. Bruno termina as outras entrevistas às 18h. Na segunda, o relatório chega completo, e a renovação sai. No caminho de casa, Kátia pergunta o que a mãe disse; Zuleide responde que isso é dela, e as duas seguem caladas.","em_aberto":"Kátia ficou fora da conversa para proteger a fala da mãe. Quem cuida dela agora sabe menos do que precisa?"},"D5":{"carimbo":"A FAMÍLIA RESPONDEU","titulo":"O relatório completo, sem a voz dela","texto":"Ainda de manhã, como Luís sugeriu, os familiares respondem pelos idosos que faltavam; Kátia responde pela mãe, e Zuleide assente. No campo de Zuleide fica: \"Caminha por ordem médica; tem medo de cair.\" Na segunda, o relatório chega completo à Secretaria, sem dizer quem respondeu cada entrevista, e a renovação de Rita sai. Na terça, Zuleide não puxa o alongamento: fica no fim da fila. Rita pergunta o que houve. Zuleide responde: \"No papel, eu sou a que caiu.\"","em_aberto":"Um relatório que salva o grupo e apaga quem o grupo serve cumpriu o seu papel?"},"D6":{"carimbo":"FORA DA AMOSTRA","titulo":"Dispensada para não se emocionar","texto":"Ainda de manhã, a entrevista de Zuleide é encerrada, e ela sai da amostra \"para não se emocionar mais\". Ninguém pergunta se ela queria parar; Kátia agradece. Bruno termina as outras dez à tarde, e na segunda o relatório chega à Secretaria com a ficha de Zuleide marcada \"não concluiu\". A renovação sai. Na terça, Zuleide caminha, mas deixa outra pessoa puxar o alongamento. Pergunta a Rita, baixinho, por que a dispensaram \"como se eu fosse quebrar\".","em_aberto":"Poupar alguém de uma emoção que ela aceitava sentir é cuidado ou tutela?"}},"leituras_percurso":[{"desfecho":"D4","papel":"bruno","marcas":["a_sos"],"carimbo_rota":"PERGUNTOU A ELA PRIMEIRO","texto":"Você chegou aqui perguntando a Zuleide, a sós, como e quando queria responder, e protegendo essa escolha quando Kátia voltou. Pesou a voz de quem participa. O custo ficou com você, na praça até as 18h, e com Kátia, que esperou de longe sem saber o que a mãe dizia."},{"desfecho":"D3","papel":"bruno","marcas":["perguntou_a_ela","juntas"],"carimbo_rota":"ELA ESCOLHEU A COMPANHIA","texto":"Você chegou aqui perguntando a Zuleide e aceitando que ela quisesse a filha ao lado. Separou as vozes no papel. O custo é o que Zuleide talvez não diga com Kátia por perto; a escolha, porém, foi dela."},{"desfecho":"D3","papel":"bruno","marcas":["levou_a_luis","juntas"],"carimbo_rota":"ACEITOU O MEIO-TERMO","texto":"Você chegou aqui levando a Luís a diferença que notou e aceitando a proposta dele: as duas juntas, cada voz em seu campo. O prazo foi cumprido, e o registro ficou honesto. Ninguém perguntou a Zuleide com quem ela queria falar, e o que ela diria a sós ficou de fora."},{"desfecho":"D1","papel":"bruno","marcas":["remarcou"],"carimbo_rota":"SUSTENTOU O PROTOCOLO","texto":"Você chegou aqui insistindo, diante de quem avalia seu estágio, em ouvir a sós quem precisava de tempo. O ofício aceitava anexo, e a renovação seguiu em análise. O custo foi um sábado a mais seu, a espera de Rita e o incômodo de Kátia."},{"desfecho":"D2","papel":"bruno","marcas":["remarcou"],"carimbo_rota":"SUSTENTOU O PROTOCOLO","texto":"Você chegou aqui insistindo, diante de quem avalia seu estágio, em ouvir a sós quem precisava de tempo. O ofício não previa anexo, e a renovação ficou em suspenso. Enviar o relatório incompleto foi decisão de Luís, que o assina; o custo caiu sobre Rita e o grupo, que ficou sem professora."},{"desfecho":"D5","papel":"bruno","marcas":["seguiu_orientacao"],"carimbo_rota":"SEGUIU A ORIENTAÇÃO","texto":"Você chegou aqui seguindo a sugestão de quem assina sua avaliação e o relatório. A responsabilidade maior pelo atalho é de Luís, mas registrar quem respondeu também era dever seu, de entrevistador. As respostas de Kátia entraram como se fossem de Zuleide, e quem pagou foi ela, que no papel virou \"a que caiu\"."},{"desfecho":"D5","papel":"bruno","marcas":["omissao"],"carimbo_rota":"ANOTOU O QUE VEIO","texto":"Você chegou aqui sem intervir: leu as perguntas e anotou o que veio, de quem veio. Calar também foi conduta, e o roteiro pedia campo próprio para a fala da filha. A sugestão de Luís pesou sobre você; o custo ficou com Zuleide."},{"desfecho":"D6","papel":"bruno","marcas":["sem_ouvir"],"carimbo_rota":"DECIDIU POR ELA","texto":"Você chegou aqui encerrando a entrevista para poupar Zuleide, sem perguntar se ela queria parar. Ela tinha pedido para continuar, e parar era um direito dela, não uma decisão sua. A emoção foi evitada; o custo foi Zuleide sair da pesquisa como alguém que pode quebrar."},{"desfecho":"D1","papel":"luis","marcas":["pediu_prazo"],"carimbo_rota":"ASSUMIU O RISCO DO PRAZO","texto":"Você chegou aqui autorizando a remarcação e escrevendo à Secretaria. O ofício aceitava anexo, e a renovação seguiu em análise com as respostas de quem caminha. O custo foi a incerteza de Rita por duas semanas e o sábado extra de Bruno."},{"desfecho":"D2","papel":"luis","marcas":["pediu_prazo"],"carimbo_rota":"ASSUMIU O RISCO DO PRAZO","texto":"Você chegou aqui autorizando a remarcação, mesmo sem anexo previsto no ofício. Você respondeu pelo relatório e pela escolha. O custo caiu sobre Rita e o grupo, três semanas sem professora, e sobre Kátia, que passou a acompanhar a mãe."},{"desfecho":"D3","papel":"luis","marcas":["juntas"],"carimbo_rota":"VOZES SEPARADAS NO PAPEL","texto":"Você chegou aqui buscando o prazo sem misturar as vozes: idoso e familiar juntos, cada um em seu campo. O relatório disse como cada resposta foi obtida. O custo é o que Zuleide não diz com a filha ao lado, e ninguém perguntou a ela como preferia."},{"desfecho":"D3","papel":"luis","marcas":["perguntou_a_ela","juntas"],"carimbo_rota":"DEVOLVEU A FILHA AO BANCO","texto":"Você chegou aqui deixando cada idoso escolher e, depois, atendendo ao medo de Kátia. Zuleide tinha escolhido falar sem a filha, e a escolha foi desfeita sem que ela fosse ouvida de novo. As vozes ficaram separadas no papel, não no banco."},{"desfecho":"D4","papel":"luis","marcas":["a_sos"],"carimbo_rota":"A ESCOLHA DE CADA UM","texto":"Você chegou aqui pondo nas mãos de cada idoso o como e o quando, e dando a Kátia um lugar à vista e um campo próprio. O relatório saiu completo. O custo foi o dia longo de Bruno e a distância que Kátia sentiu."},{"desfecho":"D5","papel":"luis","marcas":["familia_respondeu"],"carimbo_rota":"MANTEVE O ATALHO","texto":"Você chegou aqui mantendo que os familiares respondessem pelos idosos mais lentos. Você assina o relatório, e ele não diz quem respondeu, contra a responsabilidade de mostrar como cada resposta foi obtida. A renovação veio; quem pagou foi Zuleide, apagada do grupo que a pesquisa devia descrever."},{"desfecho":"D6","papel":"luis","marcas":["sem_ouvir"],"carimbo_rota":"TIROU DE CENA","texto":"Você chegou aqui tirando Zuleide da amostra para não atrasar nem constranger. Ela tinha pedido para continuar, e ninguém perguntou de novo. O prazo foi salvo; o custo foi Zuleide tratada como frágil diante da filha e da roda."},{"desfecho":"D4","papel":"zuleide","marcas":["a_sos"],"carimbo_rota":"FALOU NO SEU TEMPO","texto":"Você chegou aqui pedindo para falar a sós e respondendo devagar, com suas palavras. A pesquisa ouviu o que só você podia dizer. O custo foi o silêncio entre você e Kátia na volta; contar ou não a ela continua sendo escolha sua."},{"desfecho":"D1","papel":"zuleide","marcas":["outro_dia"],"carimbo_rota":"PEDIU OUTRO DIA","texto":"Você chegou aqui pedindo outro dia, um direito escrito no termo. O ofício aceitava anexo, e sua resposta entrou no relatório. Prazos e ofícios eram assunto de Luís e da Secretaria, não seu."},{"desfecho":"D2","papel":"zuleide","marcas":["outro_dia"],"carimbo_rota":"PEDIU OUTRO DIA","texto":"Você chegou aqui pedindo outro dia, um direito escrito no termo. A renovação ficou em suspenso, mas quem decidiu enviar o relatório incompleto foi Luís, que responde por ele. Pedir tempo não foi o que tirou Rita da praça."},{"desfecho":"D3","papel":"zuleide","marcas":["falou_junto"],"carimbo_rota":"CORRIGIU A FILHA","texto":"Você chegou aqui dizendo, com a filha ao lado, que caminha também porque gosta. Kátia ouviu algo novo da sua boca. O que você diria sobre a casa ficou guardado, e isso também era escolha sua."},{"desfecho":"D5","papel":"zuleide","marcas":["omissao"],"carimbo_rota":"DEIXOU A FILHA FALAR","texto":"Você chegou aqui preferindo não contrariar Kátia diante dos outros. Era uma escolha sua, entre poucas. Perguntar o que você queria, e anotar quem falava, era dever de quem conduzia a pesquisa."}],"conselho":{"D1":{"objecao":"A voz de Zuleide foi protegida, mas Kátia ficou de fora e Rita passou duas semanas sem saber se continuava. Valeu adiar?","segunda":"O ofício permitia anexo, e a resposta registrada é de quem caminha. Falta cuidar de Kátia, que cuida da mãe todos os dias.","replicas":[{"texto":"Uma resposta que não é dela não serve a ninguém, nem à Secretaria.","retorno":"Você ligou validade e respeito. Considere como explicar isso a Kátia sem que ela se sinta acusada."},{"texto":"Kátia podia ter sido ouvida no mesmo dia, em campo próprio.","retorno":"Você apontou um ajuste possível. O cuidado de quem acompanha também é informação."}],"por_papel":{"zuleide":{"objecao":"Você pediu outro dia, e sua resposta só entrou no anexo. Isso atrasou alguém?","segunda":"O termo garantia esse pedido, sem perda nenhuma no grupo. O prazo era de quem conduz a pesquisa.","replicas":[{"texto":"Eu precisava de calma para falar de mim.","retorno":"Você nomeou o que precisava. É exatamente isso que o termo protege."},{"texto":"Fiquei com medo de atrapalhar a Rita.","retorno":"O medo era compreensível. Quem respondia pelo prazo eram Luís e a Secretaria, não você."}]}}},"D2":{"objecao":"A renovação ficou em suspenso, e o grupo caminhou três semanas sem professora. Proteger a validade justificava esse custo para todos?","segunda":"Uma resposta trocada também tem custo, só que invisível. A pergunta é quem decidiu correr o risco e se havia outro caminho dentro do prazo.","replicas":[{"texto":"Não dava para mandar à Secretaria respostas que não eram deles.","retorno":"Você manteve o dever de dizer como cada resposta foi obtida. Pergunte se ouvir cada idoso a sós, no mesmo dia, teria evitado o atraso."},{"texto":"Talvez desse para ouvir os onze a sós no mesmo dia.","retorno":"Você viu uma alternativa que pesava menos para o grupo. Ela custaria o dia inteiro de alguém."}],"por_papel":{"zuleide":{"objecao":"O grupo ficou sem professora enquanto a renovação esperava. Você se sente responsável?","segunda":"Pedir outro dia era seu direito. Quem decidiu mandar o relatório incompleto, sem anexo previsto, foi o coordenador.","replicas":[{"texto":"Eu só pedi o que o papel dizia que eu podia.","retorno":"É isso. Usar um direito não torna você responsável pelo prazo de outros."},{"texto":"Se eu soubesse, teria respondido no mesmo dia.","retorno":"Você pode dizer isso a Bruno da próxima vez. Mas ninguém podia exigir isso de você."}]}}},"D3":{"objecao":"As vozes ficaram separadas no papel, mas Zuleide respondeu com a filha ao lado. O campo dela guarda tudo o que ela diria a sós?","segunda":"O relatório disse como cada resposta foi obtida, e Kátia não foi afastada da mãe. O que ficou de fora pode ser o que mais importava para a pesquisa.","replicas":[{"texto":"Afastar Kátia também teria custo para as duas.","retorno":"Você pesou a relação entre mãe e filha. Pergunte se alguém perguntou a Zuleide o que ela preferia."},{"texto":"O registro é honesto: diz quem falou o quê.","retorno":"Você protegeu a integridade do relatório. Ser honesto sobre o método não garante que a voz estava livre."}],"por_papel":{"zuleide":{"objecao":"Você falou com Kátia ao lado. Disse tudo o que queria?","segunda":"Dizer à filha que gosta de caminhar já foi algo novo para ela. O que você guardou também era seu para guardar.","replicas":[{"texto":"Disse o que precisava; o resto é da minha casa.","retorno":"Você decidiu o que era público e o que não era. Isso também é falar por si."},{"texto":"Queria ter dito mais, mas não na frente dela.","retorno":"Isso pode ser dito a Bruno em outro momento, se você quiser. O termo permite."}]}}},"D4":{"objecao":"Zuleide falou livre, mas Kátia esperou de longe sem saber o que a mãe dizia. Proteger uma voz justificava afastar quem cuida?","segunda":"Kátia foi ouvida depois, em campo próprio, e ficou à vista. A distância entre as duas não nasceu na praça, mas ficou mais visível ali.","replicas":[{"texto":"Kátia teve o campo dela; a mãe teve o seu.","retorno":"Você deu lugar às duas vozes. Considere como ajudar Kátia a apoiar a mãe sem responder por ela."},{"texto":"O que Zuleide disse a sós era dela, não da filha.","retorno":"Você protegeu o que pertence a quem participa. Isso pode pesar na volta para casa."}],"por_papel":{"zuleide":{"objecao":"Você falou sem a filha, e na volta as duas ficaram caladas. Valeu?","segunda":"Você disse com suas palavras por que caminha. Contar ou não contar a Kátia continua sendo escolha sua.","replicas":[{"texto":"Valeu. Ali eu sou eu.","retorno":"Você nomeou o que o grupo é para você. Isso pode ajudar Kátia também, se um dia você quiser contar."},{"texto":"Fiquei com pena dela, esperando lá na barraca.","retorno":"Cuidar da filha e falar por si podem andar juntos. Uma conversa entre as duas, sem pressa, é um caminho."}]}}},"D5":{"objecao":"O relatório chegou completo e o grupo foi salvo, mas a ficha de Zuleide diz o que a filha pensa. Uma renovação vale um dado trocado sobre quem o grupo serve?","segunda":"Luís queria salvar o grupo, e Kátia falou por cuidado e medo. O meio escolhido apagou a pessoa que o grupo deveria servir, e o relatório não diz quem respondeu.","replicas":[{"texto":"Sem a renovação, todos perderiam a professora.","retorno":"Você pesou um bem real. Pergunte se havia meios de salvá-lo sem trocar as vozes, como o campo de informante."},{"texto":"A família conhece a rotina melhor que ninguém.","retorno":"Conhece a rotina. Os motivos e os sentimentos de Zuleide, só ela pode dizer."}],"por_papel":{"bruno":{"objecao":"Você estava com a caneta. Por que as respostas de Kátia entraram no campo de Zuleide?","segunda":"A sugestão veio de quem assina sua avaliação e o relatório, e a responsabilidade maior é dele. Mas anotar quem falou também cabia a você, e era possível sem confrontar ninguém.","replicas":[{"texto":"Eu não tinha como contrariar o coordenador.","retorno":"A pressão era real. Anotar a fala de Kátia como \"informante\" não contrariava Luís; seguia o roteiro."},{"texto":"Achei que era só desta vez.","retorno":"O que fica no relatório vira o retrato do grupo. Ainda dá para contar a Luís o que aconteceu."}]},"zuleide":{"objecao":"Kátia respondeu por você, e no papel ficou \"tem medo de cair\". Isso é você?","segunda":"Você não quis contrariar a filha diante dos outros, e isso é compreensível. Perguntar o que você queria, e anotar quem falava, era dever de quem conduzia a entrevista.","replicas":[{"texto":"Não sou. Mas eu não ia brigar com ela ali.","retorno":"Você protegeu a filha de um desacordo em público. Ainda pode pedir a Bruno para refazer a sua parte."},{"texto":"Ela fala porque tem medo por mim.","retorno":"Você reconheceu o cuidado de Kátia. O medo dela é real; os seus motivos também."}]}}},"D6":{"objecao":"Zuleide pediu para continuar e foi dispensada para não se emocionar. Poupar alguém de uma emoção que ela aceitava sentir é cuidado ou tutela?","segunda":"A intenção era proteger, e Kátia agradeceu. Mas a decisão foi tomada sobre Zuleide, não com ela.","replicas":[{"texto":"Ela estava chorando; continuar parecia crueldade.","retorno":"Você levou a emoção a sério. Oferecer pausa e escolha respeitaria a emoção e a decisão dela."},{"texto":"Uma entrevista a menos não muda o relatório.","retorno":"Pode não mudar o número. Muda o lugar de Zuleide: a pesquisa a tratou como quem não aguenta falar."}]}},"e_se":{"texto":"E se Zuleide pedisse que a filha respondesse por ela?","reflexao":"Seria uma escolha dela, e não o mesmo que Kátia ocupar a fala. Sua conduta mudaria? Como registrar essa escolha sem que as respostas pareçam ser de Zuleide?"},"trajetoria":{"protagonista":"bruno","capitulo2":{"titulo":"Duas semanas depois","abertura":{"D1":"A Secretaria recebeu o anexo e renovou o contrato de Rita. Luís pede a Bruno um protocolo para as entrevistas de outra praça, no mês que vem. Kátia procura Bruno: quer saber como apoiar a mãe sem falar por ela.","D2":"A renovação segue em suspenso, e o grupo caminha sem professora. Luís pede a Bruno um protocolo para a próxima coleta, em outra praça. Kátia, que agora vai junto às terças, procura Bruno: quer saber como apoiar a mãe sem falar por ela.","D3":"A renovação foi aprovada. Luís pede a Bruno um protocolo para a próxima coleta, em outra praça. Kátia procura Bruno: \"Eu falei demais naquele dia?\" Quer saber como apoiar a mãe sem falar por ela.","D4":"A renovação foi aprovada. Luís pede a Bruno um protocolo para a próxima coleta, em outra praça. Kátia procura Bruno: a mãe não conta o que disse, e ela quer saber como apoiá-la sem falar por ela.","D5":"A renovação foi aprovada, e Zuleide parou de puxar o alongamento. Luís pede a Bruno um protocolo para a próxima coleta, em outra praça. Kátia procura Bruno: \"Minha mãe anda calada. Eu falei demais?\"","D6":"A renovação foi aprovada. Zuleide segue fora da pesquisa e parou de puxar o alongamento. Luís pede a Bruno um protocolo para a próxima coleta, e Kátia procura Bruno: \"Ela ficou ofendida comigo também.\""},"pressao":"Luís quer o protocolo por escrito até sexta, e Kátia espera uma resposta no sábado, na praça.","opcoes":[{"id":"c_protocolo","texto":"Escrever o protocolo: primeiro perguntar a cada idoso, a sós, como e quando quer responder; o familiar fala depois, em campo próprio.","vai":"C1","por_que":"Você transformou o que viu num procedimento para todos.","bonde":{"U":2,"V":1,"I":1,"E":1,"C":1},"rel":{"U":2,"D":2,"V":1,"Cu":1,"J":2}},{"id":"c_conversa","texto":"Sentar no sábado com Zuleide e Kátia e perguntar a Zuleide em que momentos quer a ajuda da filha e em quais quer falar sozinha.","vai":"C2","por_que":"Você cuidou da relação entre as duas, pondo a palavra primeiro com Zuleide.","bonde":{"U":0,"V":2,"I":1,"E":2,"C":2},"rel":{"U":0,"D":0,"V":2,"Cu":2,"J":1}},{"id":"c_corrige","texto":"Contar a Luís, por escrito, o que aconteceu com a entrevista de Zuleide e pedir que ela seja refeita do jeito que ela escolher.","vai":"C3","so_apos":["D5","D6"],"por_que":"Você levou a quem assina o relatório um registro que precisava ser corrigido.","bonde":{"U":1,"V":2,"I":2,"E":2,"C":1},"rel":{"U":1,"D":2,"V":2,"Cu":1,"J":2}}],"desfechos":{"C1":{"carimbo":"PROTOCOLO A SÓS PRIMEIRO","texto":"Luís lê o protocolo e aprova. Na praça do outro bairro, Bruno pergunta a cada idoso, a sós, como quer responder; dois pedem o filho ao lado, e ele anota a escolha. No sábado, Kátia ouve a explicação e diz que entende, mas que continua com medo das quedas. Bruno não sabe o que responder sobre esse medo.","por_desfecho":{"D2":"Luís lê o protocolo e o anexa ao pedido de renovação, ainda em suspenso. Na praça do outro bairro, Bruno pergunta a cada idoso, a sós, como quer responder; dois pedem o filho ao lado, e ele anota a escolha. Kátia diz que entende, mas que, sem professora, continua indo junto às terças.","D5":"Luís lê o protocolo e pergunta se é uma crítica ao relatório. Bruno diz que é. Luís aprova o protocolo para a próxima coleta, mas não mexe no relatório já enviado. No sábado, Kátia ouve a explicação e olha para a mãe, no fim da fila do alongamento.","D6":"Luís aprova o protocolo para a próxima coleta: ninguém é dispensado sem ser perguntado. Na praça do outro bairro, um senhor chora numa pergunta, pede pausa e continua. Zuleide segue fora da pesquisa, e Kátia conta que a mãe ainda pergunta por que a acharam frágil."}},"C2":{"carimbo":"A PALAVRA PRIMEIRO COM ELA","texto":"No sábado, Bruno senta com as duas no banco da roda. Zuleide diz que quer a filha nas consultas, mas não na praça. Kátia demora, depois pergunta se pode caminhar ao menos a última volta. Zuleide aceita. Na terça seguinte, Kátia espera no portão, e Zuleide puxa o alongamento da roda.","por_desfecho":{"D6":"No sábado, Bruno senta com as duas no banco da roda. Zuleide diz que quer a filha nas consultas, mas não na praça, e pergunta se ainda pode entrar na pesquisa. Bruno promete levar o pedido a Luís. Kátia pergunta se pode caminhar a última volta, e Zuleide aceita."}},"C3":{"carimbo":"REGISTRO REFEITO","texto":"Bruno escreve a Luís que as respostas dos idosos mais lentos foram dadas por familiares. Luís fica calado um dia, depois manda uma errata à Secretaria: as entrevistas serão refeitas, com cada voz em seu campo. A renovação é mantida. No sábado, Zuleide responde a sós, devagar. Na avaliação de estágio, Luís escreve: \"Apontou um erro meu.\"","por_desfecho":{"D6":"Bruno escreve a Luís que Zuleide foi dispensada sem ser perguntada. Luís pede que ela seja convidada de novo. No sábado, Zuleide aceita, responde a sós, devagar, e pede para incluir uma frase: \"Eu choro fácil, mas aguento.\" Luís envia a entrevista à Secretaria como complemento. Kátia espera no portão."}}}}},"intencoes":["Garantir que Zuleide fale por si","Salvar a renovação do grupo e o contrato de Rita","Proteger Zuleide da emoção","Não magoar Kátia, que cuida da mãe","Entregar um relatório verdadeiro"],"decisivos":["Só Zuleide responde pelos próprios motivos","O prazo de segunda e o que o ofício permite","Demorar para responder não basta para supor que ela não possa decidir","O medo de Kátia de uma nova queda","O campo próprio para a fala do familiar","A avaliação de estágio assinada por Luís"]},{"id":"t5-faxina","base":"F-H-IC162","tema":5,"titulo":"O sábado de faxina perdido","gancho":"\"Me disseram que era rapidinho.\" O aluguel vence sexta.","contexto":"Bairro periférico. Uma universidade faz o diagnóstico que vai definir dia e horário de um programa de atividade física na praça, com protocolo aprovado por um comitê de ética em pesquisa.","situacao":"No sábado passado, às 8h, a mestranda Priscila entrevistou dona Cida, diarista, para o diagnóstico que vai definir dia e horário de um programa de atividade física na praça. Quem agendou foi a agente comunitária Jéssica, que disse a Cida: \"É rapidinho, meia hora.\" A entrevista durou 3h10, e Cida perdeu a faxina das nove. Na segunda, Jéssica repassou a Priscila: \"Ela quer que a pesquisa pague o dia.\" O termo prevê ressarcir transporte e lanche, R$ 25, não pagar participação e indenizar dano causado pela pesquisa. Até esta terça, seis trabalhadores informais cancelaram a entrevista do próximo sábado, e Seu Damião, pedreiro, só a mantém se receber igual. O aluguel de Cida vence sexta.","mapa_atores":[{"nome":"Dona Cida","quem":"diarista, moradora entrevistada","poder":"baixo","exposicao":"alta","ouvido":"Mandou um áudio a Priscila na terça; ninguém respondeu ainda."},{"nome":"Priscila","quem":"mestranda em Educação Física, entrevistadora","poder":"médio na pesquisa","exposicao":"média","ouvido":"Conduziu a entrevista e ainda não ouviu o áudio de Cida."},{"nome":"Jéssica","quem":"agente comunitária de saúde, agendou as entrevistas","poder":"baixo","exposicao":"média","ouvido":"Explicou a Cida, na porta dela, por que disse meia hora; à equipe, ainda não contou."},{"nome":"Renato","quem":"professor, coordenador do projeto","poder":"alto","exposicao":"média","ouvido":"Responde ao comitê de ética pelo protocolo e à prefeitura pelo prazo do edital."},{"nome":"Seu Damião","quem":"pedreiro, morador agendado para sábado","poder":"baixo","exposicao":"média","ouvido":"Ligou para pôr uma condição e disse que à noite iria sem cobrar; ninguém da equipe respondeu."}],"piso":["Quem conduz a pesquisa responde pelas promessas feitas em nome dela: a promessa de meia hora e as 3h10 devem ser reconhecidas a Cida e levadas à coordenação.","Participar da pesquisa não é pago, e ressarcir despesas (transporte e lanche) é dever do projeto. Dano causado pela pesquisa, como a diária perdida numa entrevista que passou do combinado, dá direito a indenização, garantida pelo pesquisador e pelas instituições; cada valor é registrado com o nome do que é, e o comitê de ética é informado.","Cida e cada morador podem recusar, interromper ou retirar a participação quando quiserem, sem perder o ressarcimento nem o direito à indenização, e quem entrevista deve respeitar a duração informada no termo."],"intencoes":["Reparar a perda de Cida","Cumprir o protocolo que o comitê aprovou","Não perder da amostra quem trabalha no sábado","Cumprir o prazo do edital","Assumir o erro da equipe"],"decisivos":["A promessa de meia hora feita por Jéssica","A gravação de 3h10 e o aviso de Cida aos 52 minutos","O que o termo prevê: 40 minutos, R$ 25 de ressarcimento e indenização por dano","O aluguel que vence sexta e as três semanas do processo de indenização","Os cancelamentos de quem trabalha no sábado","O nome certo de cada valor: ressarcimento, indenização ou pagamento"],"fontes":[{"id":"f_cida","natureza":"ouvi","quem":"Cida, em áudio enviado a Priscila na terça à tarde","texto":"Cida diz: \"Não quero ganhar com pesquisa; quero não perder. A moça me disse meia hora, e eu marquei a faxina das nove. Perdi a diária de R$ 180, e a patroa mandou mensagem dizendo que chamou outra pessoa. Meu aluguel vence sexta.\"","papeis":["priscila","renato"]},{"id":"f_gravacao","natureza":"vi","quem":"Gravação da entrevista","texto":"A gravação tem 3h10. Aos 52 minutos, Cida diz: \"Tenho uma faxina às nove.\" Priscila responde: \"Falta pouco.\" Depois disso, Priscila faz 14 perguntas que não estão no roteiro, sobre o campinho e os sábados de trabalho.","papeis":["priscila","renato"]},{"id":"f_termo","natureza":"vi","quem":"Termo de consentimento assinado por Cida","texto":"O termo diz: \"A entrevista dura cerca de 40 minutos, e você pode interrompê-la quando quiser. A pesquisa ressarce transporte e lanche (R$ 25) e não paga pela participação. Se a pesquisa lhe causar algum dano, você tem direito a indenização. Dúvidas ou reclamações: comitê de ética em pesquisa.\" Logo abaixo está o telefone do comitê.","papeis":["cida","priscila"]},{"id":"f_agenda","natureza":"vi","quem":"Agenda das entrevistas do próximo sábado","texto":"A agenda tem 20 moradores. Seis, todos com trabalho informal, cancelaram desde domingo. Ao lado do nome de Seu Damião, Jéssica anotou: \"Só vem se receber o dia.\"","papeis":["priscila","renato"]},{"id":"f_damiao","natureza":"ouvi","quem":"Seu Damião, pedreiro","texto":"Seu Damião diz: \"Sábado é meu dia de obra. Se a dona Cida vai receber o dia, eu quero igual. Agora, se for de noite, eu vou e não cobro nada.\"","papeis":["cida","priscila","renato"]},{"id":"f_comite","natureza":"ouvi","quem":"Secretaria do comitê de ética, por telefone","texto":"A secretária do comitê diz: \"Diária perdida por causa da entrevista é dano, e indenizar é garantia do participante, diferente de ressarcir despesas e de pagar participação. Não depende de aprovação nossa: a instituição indeniza, registra com esse nome e nos comunica.\"","papeis":["renato"]},{"id":"f_jessica","natureza":"ouvi","quem":"Jéssica, na porta de Cida","texto":"Jéssica diz a Cida: \"O termo fala em 40 minutos, e eu arredondei para meia hora para a senhora não desistir. Ninguém combinou segurar a senhora a manhã toda. Quem decide o que a pesquisa paga é o professor Renato.\"","papeis":["cida"]},{"id":"f_cartaz","natureza":"vi","quem":"Cartaz do projeto no posto de saúde","texto":"O cartaz diz: \"Vem aí atividade física na praça! O dia e o horário vão sair do que os moradores contarem nas entrevistas.\"","papeis":["cida"]},{"id":"f_leitura_priscila","natureza":"interpretei","quem":"Priscila","texto":"Priscila tinha concluído, pelo recado de Jéssica, que Cida queria ser paga por ter dado a entrevista.","papeis":["priscila"],"corrigida_por":"f_cida"},{"id":"f_leitura_renato","natureza":"interpretei","quem":"Renato","texto":"Renato tinha concluído que os cancelamentos mostravam pouco interesse dos moradores pelo programa.","papeis":["renato"],"corrigida_por":"f_damiao"},{"id":"f_leitura_cida","natureza":"interpretei","quem":"Cida","texto":"Cida tinha concluído que a pesquisa prometeu meia hora de propósito, para segurá-la a manhã inteira.","papeis":["cida"],"corrigida_por":"f_jessica"}],"tarefa":{"pergunta":"Cruze o que você viu e ouviu: de onde veio a manhã perdida de Cida, e o que ela está pedindo?","opcoes":[{"id":"certa","texto":"A meia hora veio de Jéssica, e a entrevista seguiu após o aviso da faxina; Cida pede para não perder, não para ganhar.","retorno":"As fontes sustentam isso: a gravação mostra o aviso aos 52 minutos e as perguntas fora do roteiro, e Cida diz que quer não perder. Pagar participação e indenizar um dano causado pela pesquisa são coisas diferentes."},{"id":"pagamento","texto":"Cida quer ser paga por ter dado a entrevista, e o protocolo proíbe isso.","retorno":"Essa é a leitura do recado de Jéssica. No áudio, Cida diz que não quer ganhar com pesquisa: quer não perder o dia que a entrevista tomou."},{"id":"cida_ficou","texto":"A perda é de responsabilidade de Cida, que podia ter interrompido a entrevista.","retorno":"O termo garante que ela podia interromper, mas ela avisou da faxina e ouviu \"falta pouco\". O tempo da entrevista é responsabilidade de quem a conduz."},{"id":"nao_sei","texto":"Não sei.","retorno":"\"Não sei\" é honesto quando faltam fontes. O que decide a dúvida é comparar o recado de Jéssica com o áudio de Cida e com a gravação da entrevista."}]},"papeis":[{"i